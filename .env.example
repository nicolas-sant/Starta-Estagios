# Copie este arquivo para .env e preencha com os valores do seu projeto.
# O .env real NÃO é versionado (está no .gitignore).

# --- Públicas (vão para o navegador; protegidas pelas políticas RLS do Supabase) ---
VITE_SUPABASE_URL="https://<seu-projeto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<seu-projeto>"

# --- Servidor (mesmos valores das públicas, lidos no SSR) ---
SUPABASE_URL="https://<seu-projeto>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<seu-projeto>"

# --- SECRETAS: somente servidor. Nunca use prefixo VITE_ e nunca commite. ---
# No Lovable, ficam em Cloud → Secrets.
SUPABASE_SERVICE_ROLE_KEY=""
LOVABLE_API_KEY=""
LOVABLE_CRON_SECRET=""
LOVABLE_DB_MIGRATION_URL=""
